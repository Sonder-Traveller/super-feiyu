# 构建产物
build/
build-*/
build-docker/
out/
cmake-build-*/

# 二维码 / 绑定日志（含临时凭据痕迹）
.qq_*.png
.wechat_qr.png
# 热梗库的备份文件不入库（含原始 24 条，仅本地留档）
data/memes/memes-backup-*.tsv
data/memes/*.bak.tsv
.qq_*.log
.qq_*.err
.bridge.log
.bridge.err
*.live.log

# 编译中间文件
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
build.ninja

# 配置与密钥（绝不能进仓库）
.env
.env.*
!.env.example
config.local.json
# 本地实际配置（含部署地址等环境信息），示例见 config.example.toml
config.toml
secrets*.json

# APK 签名密钥：泄露等于别人能签你的包
keys/
*.keystore
*.jks
keystore.properties
*.p12
*.pfx

# 打包产物与缓存
gui/build/
gui/.venv/
gui/manifest.json
*.apk
*.aab

# 运行时数据
# 注意：必须写成 data/* 而不是 data/，
# 否则 git 不会进入被忽略的目录，下面的 ! 否定规则就失效了。
data/*
logs/
*.log

# 例外：形象库与热梗库随仓库分发（授权见 CREDITS.md）
# 入库不等于授权变宽，各图仍受原作者许可约束，禁止商业使用。
!data/memory/
data/memory/*
!data/memory/portraits/
!data/memory/portraits/**
!data/memes/
!data/memes/**

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# Python
__pycache__/
*.pyc
